:root {
  color-scheme: dark;
  --surface-0: #070b14;
  --surface-1: #0b1120;
  --surface-2: #10182a;
  --surface-3: #16213a;
  --line: rgba(174, 195, 226, .15);
  --line-strong: rgba(174, 195, 226, .28);
  --text: #f3f7ff;
  --text-soft: #a7b4c9;
  --muted: #71809a;
  --accent: #79f4e4;
  --accent-2: #5aa9ff;
  --accent-3: #8767f2;
  --danger: #ff7c8d;
  --warning: #ffd479;
  --shadow: 0 28px 70px rgba(0, 0, 0, .35);
  --radius: 22px;
  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: var(--surface-0);
  color: var(--text);
}

:root[data-contrast="high"] {
  --surface-0: #000;
  --surface-1: #070b11;
  --surface-2: #0c131e;
  --surface-3: #131e2d;
  --line: rgba(255,255,255,.27);
  --line-strong: rgba(255,255,255,.55);
  --text: #fff;
  --text-soft: #dbe8ff;
  --muted: #b5c4dd;
  --accent: #70ffec;
}

* { box-sizing: border-box; }
html { min-height: 100%; background: var(--surface-0); }
body { margin: 0; min-width: 320px; min-height: 100vh; overflow-x: hidden; background:
  radial-gradient(circle at 28% 16%, rgba(53, 118, 167, .12), transparent 28rem),
  radial-gradient(circle at 84% 12%, rgba(99, 68, 178, .12), transparent 30rem),
  var(--surface-0); color: var(--text); }
button, input { font: inherit; }
button { color: inherit; }
button:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.skip-link { position: fixed; left: 16px; top: -80px; z-index: 1000; background: var(--accent); color: #041118; padding: 12px 16px; border-radius: 10px; font-weight: 800; transition: top .2s; }
.skip-link:focus { top: 16px; }

.app-shell { min-height: 100vh; display: flex; flex-direction: column; }
.topbar { height: 84px; display: grid; grid-template-columns: minmax(240px, 1fr) auto minmax(240px, 1fr); align-items: center; gap: 20px; padding: 0 28px; border-bottom: 1px solid var(--line); background: rgba(7, 11, 20, .78); backdrop-filter: blur(20px); position: sticky; top: 0; z-index: 60; }
.brand { display: inline-flex; align-items: center; gap: 12px; border: 0; background: none; padding: 4px; cursor: pointer; justify-self: start; text-align: left; }
.brand-mark { width: 48px; height: 48px; color: var(--accent-2); flex: 0 0 auto; filter: drop-shadow(0 0 14px rgba(90, 169, 255, .22)); }
.brand-orb { fill: url(#brand-gradient); }
.brand-mark .brand-orb { fill: var(--accent-2); }
.brand strong { font-size: 18px; letter-spacing: -.025em; display: block; }
.brand small { display: block; margin-top: 3px; color: var(--muted); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
.mode-nav { display: inline-flex; gap: 4px; padding: 5px; border: 1px solid var(--line); background: rgba(16, 24, 42, .65); border-radius: 14px; }
.mode-button { height: 42px; display: inline-flex; align-items: center; gap: 8px; padding: 0 14px; border: 0; border-radius: 10px; background: transparent; color: var(--text-soft); cursor: pointer; transition: .2s ease; }
.mode-button:hover { color: var(--text); background: rgba(255,255,255,.04); }
.mode-button.active { color: #061016; background: linear-gradient(135deg, var(--accent), #b4fff5); box-shadow: 0 8px 24px rgba(121,244,228,.15); }
.top-actions { justify-self: end; display: flex; gap: 8px; align-items: center; }
.icon-button { width: 42px; height: 42px; display: inline-grid; place-items: center; border: 1px solid var(--line); border-radius: 12px; background: rgba(16, 24, 42, .62); cursor: pointer; color: var(--text-soft); transition: .2s ease; }
.icon-button:hover { color: var(--text); border-color: var(--line-strong); transform: translateY(-1px); }

.workspace { width: min(1680px, 100%); margin: 0 auto; display: grid; grid-template-columns: minmax(250px, 300px) minmax(540px, 1fr) minmax(280px, 340px); gap: 22px; align-items: start; padding: 24px 28px 34px; flex: 1; }
.mission-panel, .control-panel, .game-stage { border: 1px solid var(--line); background: linear-gradient(180deg, rgba(16,24,42,.88), rgba(9,15,27,.84)); border-radius: var(--radius); box-shadow: var(--shadow); }
.mission-panel, .control-panel { min-height: calc(100vh - 142px); padding: 24px; }
.game-stage { min-height: calc(100vh - 142px); padding: 17px; overflow: hidden; }
.eyebrow { color: var(--accent); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; font-weight: 800; }
h1, h2, p { margin-top: 0; }
.mission-panel h1 { margin: 9px 0 12px; font-size: clamp(22px, 2vw, 30px); line-height: 1.08; letter-spacing: -.04em; }
.mission-panel > p { color: var(--text-soft); font-size: 13px; line-height: 1.65; }
.objective-card { margin: 20px 0; padding: 15px; border: 1px solid rgba(121,244,228,.18); border-radius: 14px; background: rgba(121,244,228,.045); }
.objective-card span { display: block; color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }
.objective-card strong { display: block; margin-top: 5px; font-size: 18px; }
.progress { height: 5px; margin-top: 12px; border-radius: 99px; background: rgba(255,255,255,.08); overflow: hidden; }
.progress i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--accent), var(--accent-2)); }
.chapter-list { display: grid; gap: 5px; margin: 18px 0 24px; max-height: 240px; overflow: auto; padding-right: 3px; }
