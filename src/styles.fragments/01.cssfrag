.brand small { display: block; margin-top: 3px; color: var(--muted); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
.mode-nav { display: inline-flex; gap: 4px; padding: 5px; border: 1px solid var(--line); background: rgba(16, 24, 42, .65); border-radius: 14px; }
.mode-button { height: 42px; display: inline-flex; align-items: center; gap: 8px; padding: 0 14px; border: 0; border-radius: 10px; background: transparent; color: var(--text-soft); cursor: pointer; transition: .2s ease; }
.mode-button:hover { color: var(--text); background: rgba(255,255,255,.04); }
.mode-button.active { color: #061016; background: linear-gradient(135deg, var(--accent), #b4fff5); box-shadow: 0 8px 24px rgba(121,244,228,.15); }
.top-actions { justify-self: end; display: flex; gap: 8px; align-items: center; }
.icon-button { width: 42px; height: 42px; display: inline-grid; place-items: center; border: 1px solid var(--line); border-radius: 12px; background: rgba(16, 24, 42, .62); cursor: pointer; color: var(--text-soft); transition: .2s ease; }
.icon-button:hover { color: var(--text); border-color: var(--line-strong); transform: translateY(-1px); }

.workspace { width: min(1680px, 100%); margin: 0 auto; display: grid; grid-template-columns: minmax(250px, 300px) minmax(540px, 1fr) minmax(280px, 340px); gap: 22px; align-items: start; padding: 24px 28px 34px; flex: 1; }
.mission-panel, .control-panel, .game-stage { border: 1px solid var(--line); background: linear-gradient(180deg, rgba(16,24,42,.88), rgba(9,15,27,.84)); border-radius: var(--radius); box-shadow: var(--shadow); }
.mission-panel, .control-panel { min-height: calc(100vh - 142px); padding: 24px; }
.game-stage { min-height: calc(100vh - 142px); padding: 17px; overflow: hidden; }
.eyebrow { color: var(--accent); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; font-weight: 800; }
h1, h2, p { margin-top: 0; }
.mission-panel h1 { margin: 9px 0 12px; font-size: clamp(22px, 2vw, 30px); line-height: 1.08; letter-spacing: -.04em; }
.mission-panel > p { color: var(--text-soft); font-size: 13px; line-height: 1.65; }
.objective-card { margin: 20px 0; padding: 15px; border: 1px solid rgba(121,244,228,.18); border-radius: 14px; background: rgba(121,244,228,.045); }
.objective-card span { display: block; color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }
.objective-card strong { display: block; margin-top: 5px; font-size: 18px; }
.progress { height: 5px; margin-top: 12px; border-radius: 99px; background: rgba(255,255,255,.08); overflow: hidden; }
.progress i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--accent), var(--accent-2)); }
.chapter-list { display: grid; gap: 5px; margin: 18px 0 24px; max-height: 240px; overflow: auto; padding-right: 3px; }
.chapter { display: grid; grid-template-columns: 30px 1fr 20px; align-items: center; text-align: left; gap: 8px; border: 0; border-radius: 10px; background: transparent; padding: 9px 8px; cursor: pointer; color: var(--text-soft); }
.chapter:hover { background: rgba(255,255,255,.04); }
.chapter.active { background: rgba(90,169,255,.10); color: var(--text); }
.chapter span { color: var(--muted); font-size: 10px; letter-spacing: .08em; }
.chapter b { font-size: 12px; }
.chapter em { color: var(--accent); font-style: normal; }
.rule-stack { display: grid; gap: 9px; margin: 23px 0; }
.rule-stack > div { display: grid; grid-template-columns: 32px 1fr; gap: 11px; align-items: center; padding: 10px 0; border-top: 1px solid var(--line); }
.rule-stack i { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: rgba(90,169,255,.1); color: var(--accent-2); font-size: 11px; font-style: normal; font-weight: 800; }
.rule-stack b, .rule-stack small { display: block; }
.rule-stack b { font-size: 12px; }
.rule-stack small { margin-top: 2px; color: var(--muted); font-size: 10px; }
.event-log { margin-top: 26px; }
.event-log p { margin: 8px 0; padding-left: 12px; border-left: 2px solid var(--line-strong); color: var(--muted); font-size: 10px; line-height: 1.5; }
.event-log p:first-of-type { color: var(--text-soft); border-color: var(--accent); }

.status-bar { min-height: 60px; display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; margin-bottom: 14px; }
.status-bar > div { display: flex; flex-direction: column; justify-content: center; padding: 9px 12px; border: 1px solid var(--line); border-radius: 13px; background: rgba(5,10,19,.5); }
.status-bar span { color: var(--muted); font-size: 9px; text-transform: uppercase; letter-spacing: .1em; }
.status-bar strong { margin-top: 4px; font-size: 15px; }
.gravity-status strong { color: var(--accent); }
.board-zone { position: relative; width: min(100%, calc(100vh - 340px)); min-width: 390px; aspect-ratio: 1; margin: 12px auto 18px; }
.board-shell { position: absolute; inset: 7%; border-radius: 24px; background: linear-gradient(135deg, rgba(20,32,55,.96), rgba(7,12,22,.97)); border: 1px solid rgba(110,158,211,.24); box-shadow: inset 0 0 0 1px rgba(255,255,255,.02), inset 0 0 80px rgba(49,100,170,.08), 0 24px 80px rgba(0,0,0,.35); overflow: hidden; }
.field-lines { position: absolute; inset: 0; background:
  linear-gradient(90deg, transparent 49.8%, rgba(90,169,255,.05) 50%, transparent 50.2%),
  linear-gradient(transparent 49.8%, rgba(121,244,228,.04) 50%, transparent 50.2%),
  radial-gradient(circle at center, rgba(90,169,255,.08), transparent 58%); pointer-events: none; }
.board-grid { position: absolute; inset: 3.2%; display: grid; grid-template-columns: repeat(8, 1fr); grid-template-rows: repeat(8, 1fr); gap: clamp(3px, .55vw, 7px); }
.cell { position: relative; display: grid; place-items: center; min-width: 0; border: 1px solid rgba(145,174,216,.10); border-radius: 11px; background: rgba(255,255,255,.015); cursor: default; padding: 0; transition: background .2s, border-color .2s, box-shadow .2s; }
.mode-lab .cell, [data-mode="lab"] .cell { cursor: pointer; }
.cell::after { content: ''; position: absolute; width: 3px; height: 3px; border-radius: 50%; background: rgba(166,200,242,.28); }
.cell.target { border-color: rgba(121,244,228,.65); background: rgba(121,244,228,.06); box-shadow: inset 0 0 20px rgba(121,244,228,.06); }
