
@media (max-width: 1220px) {
  .topbar { grid-template-columns: 1fr auto; }
  .mode-nav { grid-row: 2; grid-column: 1 / -1; justify-self: center; margin-bottom: 10px; }
  .topbar { height: auto; min-height: 84px; padding-top: 10px; }
  .workspace { grid-template-columns: 230px minmax(480px, 1fr); }
  .control-panel { grid-column: 1 / -1; min-height: auto; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 28px; }
  .control-heading, .prediction, .launch-button, .secondary-actions, .control-note { grid-column: 1 / -1; }
  .mission-panel, .game-stage { min-height: auto; }
}

@media (max-width: 820px) {
  .topbar { padding: 10px 14px; gap: 10px; }
  .brand small { display: none; }
  .brand-mark { width: 40px; height: 40px; }
  .mode-nav { width: 100%; overflow-x: auto; justify-content: flex-start; }
  .mode-button { flex: 1; justify-content: center; min-width: 88px; padding: 0 8px; }
  .mode-button svg { display: none; }
  .workspace { display: flex; flex-direction: column; padding: 14px; }
  .game-stage { order: 1; width: 100%; padding: 10px; }
  .control-panel { order: 2; width: 100%; grid-template-columns: 1fr; }
  .control-heading, .prediction, .launch-button, .secondary-actions, .control-note { grid-column: auto; }
  .mission-panel { order: 3; width: 100%; min-height: auto; }
  .board-zone { min-width: 0; width: 100%; }
  .status-bar { grid-template-columns: repeat(5, minmax(58px, 1fr)); overflow-x: auto; }
  .status-bar > div { padding: 8px; }
  .status-bar strong { font-size: 12px; }
  .queue-panel { grid-template-columns: 1fr; justify-items: center; text-align: center; }
  .forecast { flex-wrap: wrap; justify-content: center; }
  footer { flex-direction: column; justify-content: center; text-align: center; padding: 14px; }
}

@media (max-width: 480px) {
  .top-actions .compact { display: none; }
  .brand strong { font-size: 15px; }
  .mode-button { min-width: 72px; font-size: 10px; }
  .workspace { padding: 8px; gap: 10px; }
  .game-stage, .mission-panel, .control-panel { border-radius: 16px; }
  .status-bar { gap: 3px; }
  .status-bar span { font-size: 7px; }
  .board-shell { border-radius: 16px; }
  .board-grid { gap: 3px; }
  .cell { border-radius: 6px; }
  .core, .capture-ghost { width: 82%; font-size: 12px; }
  .queue-core { width: 34px; height: 34px; }
  .queue-core.next { width: 44px; height: 44px; }
  .secondary-actions { grid-template-columns: 1fr; }
  .modal { padding: 21px; border-radius: 18px; }
}
.gravity-programmer { grid-column: 1 / -1; display: flex; align-items: center; justify-content: center; gap: 6px; padding-top: 9px; border-top: 1px solid var(--line); }
.gravity-programmer span { color: var(--warning); font-size: 9px; text-transform: uppercase; letter-spacing: .08em; margin-right: 4px; }
.gravity-programmer button { width: 32px; height: 32px; border: 1px solid rgba(255,212,121,.35); border-radius: 9px; background: rgba(255,212,121,.06); color: var(--warning); cursor: pointer; }
.mode-lab .cell { cursor: pointer; }
.mode-lab .cell:hover { border-color: rgba(121,244,228,.45); background: rgba(121,244,228,.05); }
.gravity-programmer button.active { background: var(--warning); color: #171005; box-shadow: 0 0 18px rgba(255,212,121,.22); }
